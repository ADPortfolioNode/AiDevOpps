# --- Provider API Keys (Required) ---
# The agent requires an OpenAI API key to function.
OPENAI_API_KEY="your_openai_api_key_here"
# Secondary provider if OpenAI fails or is unconfigured
GOOGLE_API_KEY="your_gemini_api_key_here"

# --- Pinecone Vector Store (Optional) ---
# By default the app uses an in-memory vector store (no Pinecone required).
# Set USE_PINECONE=true plus keys below to use your Pinecone index.
USE_PINECONE=false
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_INDEX="your-pinecone-index-name"

# --- Application Port (Optional) ---
# The application runs on port 3000 by default. You can override it here.
# PORT=3000